# Server Runtime
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL (Neon Serverless or Supabase connection string)
DATABASE_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/mizan_ai?sslmode=require"

# Authentication
JWT_SECRET="replace-with-at-least-32-random-characters-for-mizan-jwt"
JWT_EXPIRES_IN="7d"

# AI Orchestrator & Fallback Speech (Google AI Studio Free Tier)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
GEMINI_FALLBACK_MODEL="gemini-3.5-flash-lite"

# Ethiopian Native Speech-to-Text & Text-to-Speech (Addis AI — 500 ETB Free Signup Credit)
ADDIS_API_KEY=""
ADDIS_BASE_URL="https://api.addisassistant.com/api/v1"
ADDIS_VOICE_AM="am-hamen"
ADDIS_VOICE_OM="om-bikila"
