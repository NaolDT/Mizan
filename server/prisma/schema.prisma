generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LanguageCode {
  am
  om
  en
}

enum UserRole {
  OWNER
  ADMIN
}

enum BusinessCategory {
  RETAIL
  GROCERY
  CAFE_RESTAURANT
  TRADER
  WHOLESALE
  SERVICE
  OTHER
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  SALES
  SERVICE_INCOME
  OTHER_INCOME
  INVENTORY_PURCHASE
  TRANSPORT
  RENT
  UTILITIES
  SALARY
  FOOD
  MARKETING
  OTHER_EXPENSE
}

enum PaymentMethod {
  CASH
  TELEBIRR
  BANK
  CREDIT
}

enum TransactionSource {
  VOICE
  CHAT
  MANUAL
}

enum TransactionStatus {
  COMPLETED
  VOIDED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageModality {
  TEXT
  VOICE
}

enum ActionStatus {
  NONE
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REJECTED
}

enum RewardEventType {
  EARN_FIRST_TRANSACTIONS
  EARN_STREAK_7
  EARN_REFERRAL_REFERRER
  EARN_REFERRAL_WELCOME
  REDEEM_EXTRA_VOICE
  REDEEM_DISCOUNT
  REDEEM_STARTER_WEEK
}

enum StockMovementReason {
  RESTOCK
  SALE
  ADJUSTMENT
}

enum CustomerLedgerType {
  CREDIT_SALE
  PAYMENT
  REVERSAL
}

model User {
  id                String           @id @default(uuid()) @db.Uuid
  name              String           @db.VarChar(120)
  phone             String?          @unique @db.VarChar(24)
  email             String?          @unique @db.VarChar(160)
  passwordHash      String           @map("password_hash") @db.VarChar(255)
  preferredLanguage LanguageCode     @default(am) @map("preferred_language")
  role              UserRole         @default(OWNER)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  referralCode      String?          @unique @map("referral_code") @db.VarChar(24)

  businesses        Business[]
  transactions      Transaction[]
  conversations     AiConversation[]
  referralsMade     Referral[]       @relation("ReferrerRelation")
  referralReceived  Referral?        @relation("ReferredRelation")
  rewardEntries     RewardLedger[]
  stockMovements    StockMovement[]

  @@map("users")
}

model Business {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @map("owner_id") @db.Uuid
  name              String           @db.VarChar(140)
  category          BusinessCategory @default(RETAIL)
  location          String?          @db.VarChar(140)
  currency          String           @default("ETB") @db.VarChar(3)
  preferredLanguage LanguageCode     @default(am) @map("preferred_language")
  plan              SubscriptionPlan @default(FREE)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  transactions      Transaction[]
  conversations     AiConversation[]
  messages          AiMessage[]
  customers         Customer[]
  products          Product[]
  stockMovements    StockMovement[]
  customerLedger    CustomerLedger[]

  voiceRepliesUsed    Int       @default(0) @map("voice_replies_used")
  voiceBonusReplies   Int       @default(0) @map("voice_bonus_replies")
  usagePeriod         String    @default("") @map("usage_period") @db.VarChar(7)
  trialEndsAt         DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  nextBillDiscountPct Int       @default(0) @map("next_bill_discount_pct")

  @@index([ownerId])
  @@map("businesses")
}

model Transaction {
  id               String              @id @default(uuid()) @db.Uuid
  businessId       String              @map("business_id") @db.Uuid
  recordedById     String              @map("recorded_by_id") @db.Uuid
  type             TransactionType
  category         TransactionCategory
  amount           Decimal             @db.Decimal(12, 2)
  currency         String              @default("ETB") @db.VarChar(3)
  description      String              @db.VarChar(280)
  paymentMethod    PaymentMethod       @default(CASH) @map("payment_method")
  counterpartyName String?             @map("counterparty_name") @db.VarChar(120)
  customerId       String?             @map("customer_id") @db.Uuid
  productId        String?             @map("product_id") @db.Uuid
  quantity         Decimal?            @db.Decimal(12, 2)
  transactionDate  DateTime            @default(now()) @map("transaction_date") @db.Timestamptz(6)
  source           TransactionSource   @default(MANUAL)
  idempotencyKey   String              @map("idempotency_key") @db.VarChar(80)
  status           TransactionStatus   @default(COMPLETED)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  business         Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  recordedBy       User                @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product          Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  linkedMessages   AiMessage[]
  stockMovements   StockMovement[]
  customerLedger   CustomerLedger[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, transactionDate(sort: Desc)])
  @@index([businessId, type, category])
  @@map("transactions")
}

model AiConversation {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  language   LanguageCode @default(am)
  title      String       @default("Mizan Business Assistant") @db.VarChar(140)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   AiMessage[]

  @@index([businessId, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

model AiMessage {
  id                  String          @id @default(uuid()) @db.Uuid
  conversationId      String          @map("conversation_id") @db.Uuid
  businessId          String          @map("business_id") @db.Uuid
  role                MessageRole
  modality            MessageModality @default(TEXT)
  displayText         String          @map("display_text")
  spokenText          String?         @map("spoken_text")
  rawTranscript       String?         @map("raw_transcript")
  intent              String?         @db.VarChar(50)
  confidence          Float?
  proposedAction      Json?           @map("proposed_action")
  actionStatus        ActionStatus    @default(NONE) @map("action_status")
  linkedTransactionId String?         @map("linked_transaction_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation        AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  business            Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  linkedTransaction   Transaction?    @relation(fields: [linkedTransactionId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([businessId, actionStatus])
  @@map("ai_messages")
}

model Referral {
  id              String         @id @default(uuid()) @db.Uuid
  referrerId      String         @map("referrer_id") @db.Uuid
  referredUserId  String         @unique @map("referred_user_id") @db.Uuid
  codeUsed        String         @map("code_used") @db.VarChar(24)
  status          ReferralStatus @default(PENDING)
  qualifiedAt     DateTime?      @map("qualified_at") @db.Timestamptz(6)
  rejectionReason String?        @map("rejection_reason") @db.VarChar(40)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  referrer        User           @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser    User           @relation("ReferredRelation", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId, status])
  @@map("referrals")
}

model RewardLedger {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  type        RewardEventType
  points      Int
  description String          @db.VarChar(200)
  sourceKey   String          @map("source_key") @db.VarChar(120)
  referralId  String?         @map("referral_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("reward_ledger")
}

model Customer {
  id          String           @id @default(uuid()) @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  name        String           @db.VarChar(120)
  nameKey     String           @map("name_key") @db.VarChar(120)
  phone       String?          @db.VarChar(24)
  notes       String?          @db.VarChar(280)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  ledger      CustomerLedger[]

  @@unique([businessId, nameKey])
  @@index([businessId, createdAt(sort: Desc)])
  @@map("customers")
}

model CustomerLedger {
  id            String             @id @default(uuid()) @db.Uuid
  businessId    String             @map("business_id") @db.Uuid
  customerId    String             @map("customer_id") @db.Uuid
  type          CustomerLedgerType
  amount        Decimal            @db.Decimal(12, 2)
  note          String?            @db.VarChar(200)
  sourceKey     String?            @map("source_key") @db.VarChar(80)
  transactionId String?            @map("transaction_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transaction   Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([businessId, sourceKey])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([businessId, type])
  @@map("customer_ledger")
}

model Product {
  id                 String          @id @default(uuid()) @db.Uuid
  businessId         String          @map("business_id") @db.Uuid
  name               String          @db.VarChar(120)
  nameKey            String          @map("name_key") @db.VarChar(120)
  unit               String          @default("pcs") @db.VarChar(24)
  quantityOnHand     Decimal         @default(0) @map("quantity_on_hand") @db.Decimal(12, 2)
  lowStockThreshold  Decimal         @default(0) @map("low_stock_threshold") @db.Decimal(12, 2)
  sellingPrice       Decimal?        @map("selling_price") @db.Decimal(12, 2)
  costPrice          Decimal?        @map("cost_price") @db.Decimal(12, 2)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  business           Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  movements          StockMovement[]
  transactions       Transaction[]

  @@unique([businessId, nameKey])
  @@index([businessId, name])
  @@map("products")
}

model StockMovement {
  id             String               @id @default(uuid()) @db.Uuid
  businessId     String               @map("business_id") @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  recordedById   String               @map("recorded_by_id") @db.Uuid
  quantityDelta  Decimal              @map("quantity_delta") @db.Decimal(12, 2)
  quantityAfter  Decimal              @map("quantity_after") @db.Decimal(12, 2)
  reason         StockMovementReason
  note           String?              @db.VarChar(200)
  transactionId  String?              @map("transaction_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  recordedBy     User                 @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  transaction    Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
  @@index([businessId, createdAt(sort: Desc)])
  @@map("stock_movements")
}
