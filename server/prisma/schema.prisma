generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LanguageCode {
  am
  om
  en
}

enum UserRole {
  OWNER
  ADMIN
}

enum BusinessCategory {
  RETAIL
  GROCERY
  CAFE_RESTAURANT
  TRADER
  WHOLESALE
  SERVICE
  OTHER
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  SALES
  SERVICE_INCOME
  OTHER_INCOME
  INVENTORY_PURCHASE
  TRANSPORT
  RENT
  UTILITIES
  SALARY
  FOOD
  MARKETING
  OTHER_EXPENSE
}

enum PaymentMethod {
  CASH
  TELEBIRR
  BANK
  CREDIT
}

enum TransactionSource {
  VOICE
  CHAT
  MANUAL
  CAMERA
}

enum TransactionStatus {
  COMPLETED
  VOIDED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageModality {
  TEXT
  VOICE
  IMAGE
}

enum ActionStatus {
  NONE
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REJECTED
}

enum RewardEventType {
  EARN_FIRST_TRANSACTIONS
  EARN_STREAK_7
  EARN_REFERRAL_REFERRER
  EARN_REFERRAL_WELCOME
  REDEEM_EXTRA_VOICE
  REDEEM_DISCOUNT
  REDEEM_STARTER_WEEK
}

enum StockMovementReason {
  RESTOCK
  SALE
  ADJUSTMENT
}

enum CustomerLedgerType {
  CREDIT_SALE
  PAYMENT
  REVERSAL
}

enum PurchaseOrderStatus {
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum SupplierLedgerType {
  PURCHASE
  PAYMENT
  REVERSAL
}

enum ShopLoyaltyType {
  EARN
  REDEEM
  REVERSAL
}

enum ShopRole {
  OWNER
  MANAGER
  CASHIER
  INVENTORY
  ACCOUNTANT
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

model User {
  id                String           @id @default(uuid()) @db.Uuid
  name              String           @db.VarChar(120)
  phone             String?          @unique @db.VarChar(24)
  email             String?          @unique @db.VarChar(160)
  passwordHash      String           @map("password_hash") @db.VarChar(255)
  preferredLanguage LanguageCode     @default(am) @map("preferred_language")
  role              UserRole         @default(OWNER)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  referralCode      String?          @unique @map("referral_code") @db.VarChar(24)

  businesses        Business[]
  transactions      Transaction[]
  conversations     AiConversation[]
  referralsMade     Referral[]       @relation("ReferrerRelation")
  referralReceived  Referral?        @relation("ReferredRelation")
  rewardEntries     RewardLedger[]
  stockMovements    StockMovement[]
  priceChanges      ProductPriceHistory[]
  purchaseOrders    PurchaseOrder[]
  memberships       BusinessMembership[]
  invitedMembers    BusinessMembership[] @relation("MembershipInviter")
  auditEvents       AuditEvent[]

  @@map("users")
}

model Business {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @map("owner_id") @db.Uuid
  name              String           @db.VarChar(140)
  category          BusinessCategory @default(RETAIL)
  location          String?          @db.VarChar(140)
  currency          String           @default("ETB") @db.VarChar(3)
  preferredLanguage LanguageCode     @default(am) @map("preferred_language")
  plan              SubscriptionPlan @default(FREE)
  loyaltyEnabled    Boolean          @default(true) @map("loyalty_enabled")
  loyaltyEtbPerPoint Decimal         @default(100) @map("loyalty_etb_per_point") @db.Decimal(12, 2)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  transactions      Transaction[]
  conversations     AiConversation[]
  messages          AiMessage[]
  customers         Customer[]
  products          Product[]
  stockMovements    StockMovement[]
  customerLedger    CustomerLedger[]
  priceHistory      ProductPriceHistory[]
  recognitionHints  ProductRecognitionHint[]

  voiceRepliesUsed      Int       @default(0) @map("voice_replies_used")
  voiceBonusReplies     Int       @default(0) @map("voice_bonus_replies")
  usagePeriod           String    @default("") @map("usage_period") @db.VarChar(7)
  trialEndsAt           DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  nextBillDiscountPct   Int       @default(0) @map("next_bill_discount_pct")
  planPaidUntil         DateTime? @map("plan_paid_until") @db.Timestamptz(6)
  cancelPlanAtPeriodEnd Boolean   @default(false) @map("cancel_plan_at_period_end")

  creditLots            CreditLot[]
  creditLedger          CreditLedgerEntry[]
  aiUsages              AiUsageRecord[]
  billingPayments       BillingPayment[]
  billingNotices        BillingNotice[]
  businessNotices       BusinessNotice[]
  suppliers             Supplier[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderItems    PurchaseOrderItem[]
  supplierLedger        SupplierLedger[]
  shopLoyalty           ShopLoyaltyLedger[]
  memberships           BusinessMembership[]
  auditEvents           AuditEvent[]

  @@index([ownerId])
  @@map("businesses")
}

model BusinessMembership {
  id          String           @id @default(uuid()) @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        ShopRole         @default(CASHIER)
  status      MembershipStatus @default(ACTIVE)
  invitedById String?          @map("invited_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User?            @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([businessId, userId])
  @@index([userId, status])
  @@index([businessId, status])
  @@map("business_memberships")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(40)
  entityType  String   @map("entity_type") @db.VarChar(40)
  entityId    String?  @map("entity_id") @db.Uuid
  summary     String   @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([businessId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_events")
}

model Transaction {
  id               String              @id @default(uuid()) @db.Uuid
  businessId       String              @map("business_id") @db.Uuid
  recordedById     String              @map("recorded_by_id") @db.Uuid
  type             TransactionType
  category         TransactionCategory
  amount           Decimal             @db.Decimal(12, 2)
  currency         String              @default("ETB") @db.VarChar(3)
  description      String              @db.VarChar(280)
  paymentMethod    PaymentMethod       @default(CASH) @map("payment_method")
  counterpartyName String?             @map("counterparty_name") @db.VarChar(120)
  customerId       String?             @map("customer_id") @db.Uuid
  productId        String?             @map("product_id") @db.Uuid
  quantity         Decimal?            @db.Decimal(12, 2)
  transactionDate  DateTime            @default(now()) @map("transaction_date") @db.Timestamptz(6)
  source           TransactionSource   @default(MANUAL)
  idempotencyKey   String              @map("idempotency_key") @db.VarChar(80)
  status           TransactionStatus   @default(COMPLETED)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  business         Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  recordedBy       User                @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  customer         Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product          Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  purchaseOrder    PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  purchaseOrderId  String?             @map("purchase_order_id") @db.Uuid
  linkedMessages   AiMessage[]
  stockMovements   StockMovement[]
  customerLedger   CustomerLedger[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, transactionDate(sort: Desc)])
  @@index([businessId, type, category])
  @@map("transactions")
}

model AiConversation {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  language   LanguageCode @default(am)
  title      String       @default("Mizan Business Assistant") @db.VarChar(140)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   AiMessage[]

  @@index([businessId, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

model AiMessage {
  id                  String          @id @default(uuid()) @db.Uuid
  conversationId      String          @map("conversation_id") @db.Uuid
  businessId          String          @map("business_id") @db.Uuid
  role                MessageRole
  modality            MessageModality @default(TEXT)
  displayText         String          @map("display_text")
  spokenText          String?         @map("spoken_text")
  rawTranscript       String?         @map("raw_transcript")
  intent              String?         @db.VarChar(50)
  confidence          Float?
  proposedAction      Json?           @map("proposed_action")
  actionStatus        ActionStatus    @default(NONE) @map("action_status")
  linkedTransactionId String?         @map("linked_transaction_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation        AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  business            Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  linkedTransaction   Transaction?    @relation(fields: [linkedTransactionId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([businessId, actionStatus])
  @@map("ai_messages")
}

model Referral {
  id              String         @id @default(uuid()) @db.Uuid
  referrerId      String         @map("referrer_id") @db.Uuid
  referredUserId  String         @unique @map("referred_user_id") @db.Uuid
  codeUsed        String         @map("code_used") @db.VarChar(24)
  status          ReferralStatus @default(PENDING)
  qualifiedAt     DateTime?      @map("qualified_at") @db.Timestamptz(6)
  rejectionReason String?        @map("rejection_reason") @db.VarChar(40)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  referrer        User           @relation("ReferrerRelation", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser    User           @relation("ReferredRelation", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId, status])
  @@map("referrals")
}

model RewardLedger {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  type        RewardEventType
  points      Int
  description String          @db.VarChar(200)
  sourceKey   String          @map("source_key") @db.VarChar(120)
  referralId  String?         @map("referral_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("reward_ledger")
}

model Customer {
  id          String           @id @default(uuid()) @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  name        String           @db.VarChar(120)
  nameKey     String           @map("name_key") @db.VarChar(120)
  phone       String?          @db.VarChar(24)
  notes       String?          @db.VarChar(280)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  ledger      CustomerLedger[]
  loyalty     ShopLoyaltyLedger[]

  @@unique([businessId, nameKey])
  @@index([businessId, createdAt(sort: Desc)])
  @@map("customers")
}

model CustomerLedger {
  id            String             @id @default(uuid()) @db.Uuid
  businessId    String             @map("business_id") @db.Uuid
  customerId    String             @map("customer_id") @db.Uuid
  type          CustomerLedgerType
  amount        Decimal            @db.Decimal(12, 2)
  note          String?            @db.VarChar(200)
  sourceKey     String?            @map("source_key") @db.VarChar(80)
  transactionId String?            @map("transaction_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transaction   Transaction?       @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([businessId, sourceKey])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([businessId, type])
  @@map("customer_ledger")
}

model ShopLoyaltyLedger {
  id            String          @id @default(uuid()) @db.Uuid
  businessId    String          @map("business_id") @db.Uuid
  customerId    String          @map("customer_id") @db.Uuid
  type          ShopLoyaltyType
  points        Int
  note          String?         @db.VarChar(200)
  sourceKey     String          @map("source_key") @db.VarChar(80)
  transactionId String?         @map("transaction_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([businessId, sourceKey])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([businessId, type])
  @@map("shop_loyalty_ledger")
}

model Product {
  id                 String          @id @default(uuid()) @db.Uuid
  businessId         String          @map("business_id") @db.Uuid
  name               String          @db.VarChar(120)
  nameKey            String          @map("name_key") @db.VarChar(120)
  brand              String?         @db.VarChar(80)
  sizeLabel          String?         @map("size_label") @db.VarChar(40)
  categoryLabel      String?         @map("category_label") @db.VarChar(40)
  barcode            String?         @db.VarChar(64)
  aliases            String?         @db.VarChar(280)
  unit               String          @default("pcs") @db.VarChar(24)
  quantityOnHand     Decimal         @default(0) @map("quantity_on_hand") @db.Decimal(12, 2)
  lowStockThreshold  Decimal         @default(0) @map("low_stock_threshold") @db.Decimal(12, 2)
  maxStockLevel      Decimal         @default(0) @map("max_stock_level") @db.Decimal(12, 2)
  sellingPrice       Decimal?        @map("selling_price") @db.Decimal(12, 2)
  costPrice          Decimal?        @map("cost_price") @db.Decimal(12, 2)
  imageMime          String?         @map("image_mime") @db.VarChar(40)
  imageBytes         Bytes?          @map("image_bytes")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  business           Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  movements          StockMovement[]
  transactions       Transaction[]
  purchaseOrderItems PurchaseOrderItem[]
  priceHistory       ProductPriceHistory[]
  recognitionHints   ProductRecognitionHint[]

  @@unique([businessId, nameKey])
  @@index([businessId, name])
  @@index([businessId, barcode])
  @@map("products")
}

model ProductPriceHistory {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  recordedById   String   @map("recorded_by_id") @db.Uuid
  sellingPrice   Decimal? @map("selling_price") @db.Decimal(12, 2)
  costPrice      Decimal? @map("cost_price") @db.Decimal(12, 2)
  previousSelling Decimal? @map("previous_selling") @db.Decimal(12, 2)
  previousCost   Decimal? @map("previous_cost") @db.Decimal(12, 2)
  note           String?  @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  recordedBy     User     @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([productId, createdAt(sort: Desc)])
  @@map("product_price_history")
}

model ProductRecognitionHint {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  barcode       String?  @db.VarChar(64)
  detectedName  String   @map("detected_name") @db.VarChar(160)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId, detectedName])
  @@index([businessId, barcode])
  @@map("product_recognition_hints")
}

model StockMovement {
  id             String               @id @default(uuid()) @db.Uuid
  businessId     String               @map("business_id") @db.Uuid
  productId      String               @map("product_id") @db.Uuid
  recordedById   String               @map("recorded_by_id") @db.Uuid
  quantityDelta  Decimal              @map("quantity_delta") @db.Decimal(12, 2)
  quantityAfter  Decimal              @map("quantity_after") @db.Decimal(12, 2)
  reason         StockMovementReason
  note           String?              @db.VarChar(200)
  transactionId  String?              @map("transaction_id") @db.Uuid
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  recordedBy     User                 @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  transaction    Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt(sort: Desc)])
  @@index([businessId, createdAt(sort: Desc)])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Hybrid billing: plan catalog, AI credit wallet, top-ups, payments
// ─────────────────────────────────────────────────────────────────────────────

enum CreditSource {
  SUBSCRIPTION
  PURCHASED
  REFERRAL
  PROMO
  ADMIN
}

enum CreditEntryType {
  ALLOCATION
  USAGE
  TOPUP
  REFERRAL_REWARD
  PROMO_REWARD
  ADMIN_GRANT
  ADMIN_DEBIT
  EXPIRATION
  REFUND
}

enum BillingPaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum BillingPaymentPurpose {
  SUBSCRIPTION
  TOPUP
}

enum BillingProvider {
  CHAPA
  DEV
}

enum AiCreditFeature {
  TEXT_CHAT
  VOICE_TURN
  TTS
  VISION
  RECEIPT
}

enum PromotionKind {
  WELCOME
}

/// Prices, monthly credits and feature flags for the existing four plans.
/// Rows are seeded from the current catalog and then edited without a deploy.
model BillingPlanConfig {
  plan              SubscriptionPlan @id
  name              String           @db.VarChar(60)
  description       String           @db.VarChar(280)
  priceEtb          Decimal          @map("price_etb") @db.Decimal(12, 2)
  monthlyCredits    Int              @map("monthly_credits")
  monthlyReplies    Int              @map("monthly_replies")
  voiceEnabled      Boolean          @default(true) @map("voice_enabled")
  cameraEnabled     Boolean          @default(true) @map("camera_enabled")
  analyticsEnabled  Boolean          @default(true) @map("analytics_enabled")
  productLimit      Int?             @map("product_limit")
  customerLimit     Int?             @map("customer_limit")
  active            Boolean          @default(true)
  displayOrder      Int              @default(0) @map("display_order")
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("billing_plan_configs")
}

model TopUpPackage {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(40)
  name          String   @db.VarChar(60)
  description   String   @db.VarChar(280)
  priceEtb      Decimal  @map("price_etb") @db.Decimal(12, 2)
  credits       Int
  bonusCredits  Int      @default(0) @map("bonus_credits")
  validityDays  Int      @map("validity_days")
  active        Boolean  @default(true)
  displayOrder  Int      @default(0) @map("display_order")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("top_up_packages")
}

model AiCreditPrice {
  feature   AiCreditFeature @id
  credits   Int
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ai_credit_prices")
}

model BillingSetting {
  id                        String   @id @default("default") @db.VarChar(16)
  referralReferrerCredits   Int      @default(30) @map("referral_referrer_credits")
  referralWelcomeCredits    Int      @default(15) @map("referral_welcome_credits")
  referralCreditDays        Int      @default(60) @map("referral_credit_days")
  lowBalanceThreshold       Int      @default(10) @map("low_balance_threshold")
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("billing_settings")
}

model BillingPromotion {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique @db.VarChar(40)
  kind         PromotionKind
  name         String        @db.VarChar(80)
  credits      Int
  validityDays Int           @map("validity_days")
  active       Boolean       @default(false)
  startsAt     DateTime?     @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime?     @map("ends_at") @db.Timestamptz(6)
  maxGrants    Int?          @map("max_grants")
  grantCount   Int           @default(0) @map("grant_count")
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("billing_promotions")
}

/// One grant of credits. Remaining falls as credits are spent. periodKey makes
/// the same monthly grant, payment or referral reward impossible to apply twice.
model CreditLot {
  id          String       @id @default(uuid()) @db.Uuid
  businessId  String       @map("business_id") @db.Uuid
  source      CreditSource
  original    Int
  remaining   Int
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(6)
  periodKey   String       @map("period_key") @db.VarChar(120)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  draws       CreditDraw[]

  @@unique([businessId, source, periodKey])
  @@index([businessId, expiresAt])
  @@map("credit_lots")
}

model CreditLedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  businessId     String          @map("business_id") @db.Uuid
  userId         String?         @map("user_id") @db.Uuid
  type           CreditEntryType
  source         CreditSource
  amount         Int
  balanceAfter   Int             @map("balance_after")
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(200)
  paymentId      String?         @map("payment_id") @db.Uuid
  usageId        String?         @map("usage_id") @db.Uuid
  description    String          @db.VarChar(240)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payment        BillingPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt(sort: Desc)])
  @@map("credit_ledger_entries")
}

model CreditDraw {
  id        String    @id @default(uuid()) @db.Uuid
  usageId   String    @map("usage_id") @db.Uuid
  lotId     String    @map("lot_id") @db.Uuid
  amount    Int
  refunded  Boolean   @default(false)

  usage     AiUsageRecord @relation(fields: [usageId], references: [id], onDelete: Cascade)
  lot       CreditLot     @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([usageId])
  @@map("credit_draws")
}

model AiUsageRecord {
  id             String          @id @default(uuid()) @db.Uuid
  businessId     String          @map("business_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  feature        AiCreditFeature
  provider       String?         @db.VarChar(40)
  creditsCharged Int             @map("credits_charged")
  status         String          @db.VarChar(16)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  draws          CreditDraw[]

  @@index([businessId, createdAt(sort: Desc)])
  @@map("ai_usage_records")
}

model BillingPayment {
  id              String                 @id @default(uuid()) @db.Uuid
  businessId      String                 @map("business_id") @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  purpose         BillingPaymentPurpose
  provider        BillingProvider
  status          BillingPaymentStatus   @default(PENDING)
  plan            SubscriptionPlan?
  packageCode     String?                @map("package_code") @db.VarChar(40)
  title           String                 @db.VarChar(120)
  amount          Decimal                @db.Decimal(12, 2)
  currency        String                 @default("ETB") @db.VarChar(3)
  creditsToGrant  Int                    @map("credits_to_grant")
  validityDays    Int                    @default(30) @map("validity_days")
  txRef           String                 @unique @map("tx_ref") @db.VarChar(64)
  providerRef     String?                @map("provider_ref") @db.VarChar(120)
  checkoutUrl     String?                @map("checkout_url") @db.VarChar(500)
  devOutcome      String?                @map("dev_outcome") @db.VarChar(16)
  failureReason   String?                @map("failure_reason") @db.VarChar(80)
  fulfilledAt     DateTime?              @map("fulfilled_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  business        Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ledger          CreditLedgerEntry[]

  @@index([businessId, createdAt(sort: Desc)])
  @@map("billing_payments")
}

model BillingNotice {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  kind       String    @db.VarChar(40)
  amount     Int?
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt(sort: Desc)])
  @@map("billing_notices")
}

model Supplier {
  id          String           @id @default(uuid()) @db.Uuid
  businessId  String           @map("business_id") @db.Uuid
  name        String           @db.VarChar(120)
  nameKey     String           @map("name_key") @db.VarChar(120)
  phone       String?          @db.VarChar(24)
  notes       String?          @db.VarChar(280)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  orders      PurchaseOrder[]
  ledger      SupplierLedger[]

  @@unique([businessId, nameKey])
  @@index([businessId, createdAt(sort: Desc)])
  @@map("suppliers")
}

model PurchaseOrder {
  id             String              @id @default(uuid()) @db.Uuid
  businessId     String              @map("business_id") @db.Uuid
  supplierId     String              @map("supplier_id") @db.Uuid
  recordedById   String              @map("recorded_by_id") @db.Uuid
  status         PurchaseOrderStatus @default(ORDERED)
  notes          String?             @db.VarChar(280)
  idempotencyKey String              @map("idempotency_key") @db.VarChar(80)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  recordedBy     User                @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  items          PurchaseOrderItem[]
  ledger         SupplierLedger[]
  transactions   Transaction[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, createdAt(sort: Desc)])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String        @id @default(uuid()) @db.Uuid
  businessId        String        @map("business_id") @db.Uuid
  purchaseOrderId   String        @map("purchase_order_id") @db.Uuid
  productId         String        @map("product_id") @db.Uuid
  description       String        @db.VarChar(160)
  quantityOrdered   Decimal       @map("quantity_ordered") @db.Decimal(12, 2)
  quantityReceived  Decimal       @default(0) @map("quantity_received") @db.Decimal(12, 2)
  unitCost          Decimal       @map("unit_cost") @db.Decimal(12, 2)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([businessId, productId])
  @@map("purchase_order_items")
}

model SupplierLedger {
  id              String             @id @default(uuid()) @db.Uuid
  businessId      String             @map("business_id") @db.Uuid
  supplierId      String             @map("supplier_id") @db.Uuid
  type            SupplierLedgerType
  amount          Decimal            @db.Decimal(12, 2)
  note            String?            @db.VarChar(200)
  sourceKey       String?            @map("source_key") @db.VarChar(80)
  purchaseOrderId String?            @map("purchase_order_id") @db.Uuid
  transactionId   String?            @map("transaction_id") @db.Uuid
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier        Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@unique([businessId, sourceKey])
  @@index([supplierId, createdAt(sort: Desc)])
  @@index([businessId, type])
  @@map("supplier_ledger")
}

model BusinessNotice {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  kind        String    @db.VarChar(40)
  severity    String    @db.VarChar(16)
  entityType  String    @default("NONE") @map("entity_type") @db.VarChar(20)
  entityId    String?   @map("entity_id") @db.Uuid
  periodKey   String    @map("period_key") @db.VarChar(120)
  payload     Json
  dismissedAt DateTime? @map("dismissed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, periodKey])
  @@index([businessId, dismissedAt, createdAt(sort: Desc)])
  @@map("business_notices")
}
