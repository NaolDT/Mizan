{
  "installCommand": "cd .. && npm ci --include=dev",
  "buildCommand": "cd .. && npm run build --workspace=shared && npm run build --workspace=client",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mizan-vwqy.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
